[
  {
    "metric_name": "gmv",
    "display_name": "GMV",
    "definition": "Gross merchandise value from paid orders within the selected time window.",
    "owner": "content_commerce_ops",
    "unit": "CNY",
    "allowed_schemas": ["sales"],
    "dimensions": ["order_date"],
    "data_classification": "internal",
    "verified_queries": [
      {
        "template_id": "content_commerce_metric_daily",
        "metric_name": "gmv",
        "sql": "select order_date, sum(paid_amount) as value from sales.orders where order_date >= :start_date and order_date < :end_date group by order_date limit :limit",
        "required_parameters": ["start_date", "end_date", "limit"],
        "required_time_parameters": ["start_date", "end_date"],
        "default_limit": 100,
        "max_limit": 1000,
        "allow_select_star": false
      }
    ],
    "quality_contract": {
      "freshness": "1d",
      "null_rate": "<1%",
      "owner": "data_platform"
    },
    "action_candidates": [
      {
        "action_id": "alert_gmv_drop",
        "trigger": "value < threshold",
        "risk_level": "R2",
        "description": "Notify ops when GMV drops below threshold."
      }
    ],
    "feedback_metric": "gmv"
  },
