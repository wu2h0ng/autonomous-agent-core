# API keys for strong-locus Stage 4 leak-probe and real-LLM harness.
# Copy this file to .env and fill in ONE of the keys.
# .env is gitignored and must never be committed.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: override the default API endpoint for OpenAI/Anthropic-compatible proxies.
# ANTHROPIC_API_URL=https://api.kimi.com/coding/v1/messages
# OPENAI_API_URL=https://api.kimi.com/coding/v1/chat/completions

# Optional: override the default model name.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-2024-08-06

# Optional: override temperature. Some providers (e.g. Kimi) only support temperature=1.0.
# ANTHROPIC_TEMPERATURE=0.0
# OPENAI_TEMPERATURE=1.0
