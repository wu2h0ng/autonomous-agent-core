# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=agent_os
POSTGRES_PASSWORD=agent_os_secret
POSTGRES_DB=agent_os
POSTGRES_PORT=5432

# ── API Server ─────────────────────────────────────────────────────────────
API_PORT=8000
# Query executor: "static" (deterministic fixtures) or "sqlite" (real SQL)
AGENT_OS_EXECUTOR=sqlite
# Authentication keys (change in production!)
AGENT_OS_API_KEY=dev-internal-key
AGENT_OS_EXTERNAL_API_KEY=dev-external-key
AGENT_OS_OPERATOR_API_KEY=dev-operator-key

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RUN_KEY=dev-internal-key

# ── LLM / Embedding (optional) ────────────────────────────────────────────
# LLM_API_KEY=sk-...
# EMBEDDING_API_KEY=sk-...

# ── Debug ──────────────────────────────────────────────────────────────────
DEBUG_PORT=5678
