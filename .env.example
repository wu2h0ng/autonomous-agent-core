# Agent OS / Agent CLI multi-provider credentials
# Copy to .env and fill keys. .env is gitignored — never commit it.
#
# Switch active provider:
#   AGENT_OS_PROVIDER_PROFILE=kimi|openai|anthropic|deepseek
# Optional overrides (win over profile):
#   AGENT_OS_PROVIDER_BASE_URL=
#   AGENT_OS_PROVIDER_MODEL=
#   AGENT_OS_PROVIDER_API_KEY_ENV=
#   AGENT_OS_PROVIDER_TEMPERATURE=

AGENT_OS_PROVIDER_PROFILE=kimi

# --- kimi ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-k2-0711-preview
KIMI_TEMPERATURE=1.0

# --- openai ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=1.0

# --- anthropic (OpenAI-compatible proxy endpoint only for Agent CLI V0) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_TEMPERATURE=0.0

# --- deepseek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=1.0
