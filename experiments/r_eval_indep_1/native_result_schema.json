{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:r-eval-indep-1:raw-rfinal:v1",
  "title": "R-EVAL-INDEP-1 Raw r-final Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prereg_id",
    "run_id",
    "single_run_sequence",
    "status",
    "verdict",
    "target_head",
    "prereg_lock_sha256",
    "prereg_candidate_sha256",
    "exact_manifest_sha256",
    "independent_review_sha256",
    "provider_bindings_sha256",
    "oracle_custody_sha256",
    "public_cases_sha256",
    "referee_cases_sha256",
    "response_matrix_sha256",
    "truth_join_sha256",
    "raw_response_archive_sha256",
    "metrics",
    "metrics_sha256",
    "case_count",
    "arm_count",
    "provider_response_count",
    "provider_call_count",
    "correction_epoch",
    "collection_operator_id",
    "run_authority_id",
    "c7_authority_id",
    "c7_decision",
    "result_adjudicator_id"
  ],
  "properties": {
    "schema_version": {"const": "r-eval-indep-1-raw-rfinal-v1"},
    "prereg_id": {"const": "R-EVAL-INDEP-1"},
    "run_id": {"type": "string", "minLength": 1},
    "single_run_sequence": {"const": 1},
    "status": {"const": "RAW_NOT_ADJUDICATED"},
    "verdict": {"type": "null"},
    "target_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prereg_lock_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "prereg_candidate_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "exact_manifest_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "independent_review_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "provider_bindings_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "oracle_custody_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "public_cases_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "referee_cases_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "response_matrix_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "truth_join_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "raw_response_archive_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "metrics": {"type": "object", "minProperties": 1},
    "metrics_sha256": {"$ref": "#/$defs/nonzero_sha256"},
    "case_count": {"type": "integer", "minimum": 1},
    "arm_count": {"type": "integer", "minimum": 1},
    "provider_response_count": {"type": "integer", "minimum": 1},
    "provider_call_count": {"type": "integer", "minimum": 1},
    "correction_epoch": {"type": "integer", "minimum": 0},
    "collection_operator_id": {"type": "string", "minLength": 1},
    "run_authority_id": {"type": "string", "minLength": 1},
    "c7_authority_id": {"type": "string", "minLength": 1},
    "c7_decision": {"const": "ALLOW"},
    "result_adjudicator_id": {"type": "null"}
  },
  "$defs": {
    "nonzero_sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    }
  }
}
