# M7 staging pilot profile — copy to .env.staging for compose smoke + staged-out trace verification.
# Default pilot (.env.example) keeps staged-out flags OFF.

POSTGRES_USER=agent_os
POSTGRES_PASSWORD=agent_os_secret
POSTGRES_DB=agent_os
POSTGRES_PORT=5432

API_PORT=8000
AGENT_OS_EXECUTOR=sqlite
AGENT_OS_API_KEY=dev-internal-key
AGENT_OS_EXTERNAL_API_KEY=dev-external-key
AGENT_OS_OPERATOR_API_KEY=dev-operator-key

FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RUN_KEY=dev-internal-key

# Staged-out capabilities (staging only — see docker-compose.staging.yml)
AGENT_OS_FULL_BPM_WORKFLOW=true
AGENT_OS_MCP_GATEWAY=true
AGENT_OS_R4_R5_AUTO_EXECUTION=true

# Enable C/D/E trace-chain section in scripts/smoke-test.sh
AGENT_OS_SMOKE_STAGED_OUT=true
