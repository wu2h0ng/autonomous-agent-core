      "BlockDetail": {
        "description": "The unified business-block contract (AR-20260606-unified-block-outcome).\n\nReturned as the 422 ``detail`` when the Trusted Loop refuses to answer\n(unsafe SQL, unknown metric, no template, no provider, ...). ``trace_id``\nreferences the persisted RunTrace of the refusal (AR-20260611).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
