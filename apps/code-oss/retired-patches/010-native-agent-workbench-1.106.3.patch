@@ -0,0 +1,19 @@
+import { IInstantiationService } from '../../../platform/instantiation/common/instantiation.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../common/contributions.js';
+import { IWorkbenchLayoutService, Parts } from '../../services/layout/browser/layoutService.js';
+import { mainWindow } from '../../../base/browser/window.js';
+import { AgentOSMasterPart, AgentOSTaskListPart, AgentOSWorkbenchParts } from './agentOSWindowEditor.js';
+
+// Named exports keep the Agent Window's stable native Part contract explicit.
+export { AgentOSMasterPart, AgentOSTaskListPart };
+class AgentOSWindowLayoutContribution implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.agentOSWindowLayout';
+	constructor(@IWorkbenchLayoutService layoutService: IWorkbenchLayoutService, @IInstantiationService instantiationService: IInstantiationService) {
+		const editorContainer = layoutService.getContainer(mainWindow, Parts.EDITOR_PART);
+		const host = editorContainer?.parentElement;
+		if (!host) { throw new Error('Agent OS Workbench host is unavailable'); }
+		for (const part of [Parts.ACTIVITYBAR_PART, Parts.SIDEBAR_PART, Parts.EDITOR_PART, Parts.AUXILIARYBAR_PART, Parts.PANEL_PART, Parts.STATUSBAR_PART]) { layoutService.setPartHidden(true, part); }
+		instantiationService.createInstance(AgentOSWorkbenchParts).create(host);
+	}
+}
+registerWorkbenchContribution2(AgentOSWindowLayoutContribution.ID, AgentOSWindowLayoutContribution, WorkbenchPhase.AfterRestored);
diff --git a/src/vs/workbench/agentOSWindow/browser/agentOSWindowEditor.ts b/src/vs/workbench/agentOSWindow/browser/agentOSWindowEditor.ts
new file mode 100644
index 0000000..42cb27f
--- /dev/null
+++ b/src/vs/workbench/agentOSWindow/browser/agentOSWindowEditor.ts
@@ -0,0 +1,78 @@
+import './media/agentOSWindow.css';
+import * as DOM from '../../../base/browser/dom.js';
+import { Disposable } from '../../../base/common/lifecycle.js';
+import { localize } from '../../../nls.js';
+
+const $ = DOM.$;
+
+export class AgentOSTaskListPart extends Disposable {
+	create(parent: HTMLElement, focusComposer: () => void): void {
+		const rail = DOM.append(parent, $('aside.agent-os-task-rail'));
+		DOM.append(rail, $('div.agent-os-brand', undefined, 'Agent OS'));
+		const create = DOM.append(rail, $('button.agent-os-new-task', { type: 'button' }, localize('newTask', "+ 新建任务")));
+		this._register(DOM.addDisposableListener(create, DOM.EventType.CLICK, focusComposer));
+		const nav = DOM.append(rail, $('nav.agent-os-nav'));
+		for (const [label, active] of [[localize('tasks', "任务"), true], [localize('automations', "自动任务"), false], [localize('knowledge', "知识"), false]] as const) {
+			DOM.append(nav, $(`button.agent-os-nav-item${active ? '.active' : ''}`, { type: 'button' }, label));
+		}
+		DOM.append(rail, $('div.agent-os-section-label', undefined, localize('recentWork', "最近工作")));
+		const list = DOM.append(rail, $('div.agent-os-task-list'));
+		DOM.append(list, $('button.agent-os-task.active', { type: 'button' }, localize('currentTask', "构建 Agent Workbench")));
+		DOM.append(list, $('button.agent-os-task', { type: 'button' }, localize('previousTask', "整理产品需求")));
+	}
+}
+
+export class AgentOSMasterPart extends Disposable {
+	private input: HTMLTextAreaElement | undefined;
+	create(parent: HTMLElement, onSubmit: (goal: string) => void): void {
+		const main = DOM.append(parent, $('main.agent-os-main'));
+		const header = DOM.append(main, $('header.agent-os-main-header'));
+		DOM.append(header, $('div.agent-os-eyebrow', undefined, localize('agentWorkspace', "任务工作台")));
+		DOM.append(header, $('h1', undefined, localize('giveGoal', "把目标交给 Agent OS")));
+		DOM.append(header, $('p', undefined, localize('goalHelp', "描述结果，系统按需使用技能、工具与内部 Agent。")));
+		const composer = DOM.append(main, $('section.agent-os-composer'));
+		this.input = DOM.append(composer, $('textarea.agent-os-prompt', { rows: 5, placeholder: localize('promptPlaceholder', "描述你想完成的结果，@ 引用文件、对话或任务，/ 使用技能") })) as HTMLTextAreaElement;
+		const toolbar = DOM.append(composer, $('div.agent-os-composer-toolbar'));
+		DOM.append(toolbar, $('button.agent-os-icon-button', { type: 'button', title: localize('attach', "添加文件、文件夹或上下文") }, '+'));
+		DOM.append(toolbar, $('span.agent-os-selection', undefined, localize('selection', "按需选择工具与技能")));
+		const send = DOM.append(toolbar, $('button.agent-os-send', { type: 'button' }, '↑'));
+		this._register(DOM.addDisposableListener(send, DOM.EventType.CLICK, () => {
+			const goal = this.input?.value.trim(); if (!goal) { this.input?.focus(); return; }
+			onSubmit(goal); if (this.input) { this.input.value = ''; }
+		}));
+		const starters = DOM.append(main, $('div.agent-os-starters'));
+		for (const label of [localize('organizeIdea', "整理一个想法"), localize('startResearch', "开始研究"), localize('buildSoftware', "构建软件")]) {
+			const button = DOM.append(starters, $('button', { type: 'button' }, label));
+			this._register(DOM.addDisposableListener(button, DOM.EventType.CLICK, () => { if (this.input) { this.input.value = label; this.input.focus(); } }));
+		}
+		DOM.append(main, $('div.agent-os-run-feed'));
+	}
+	focus(): void { this.input?.focus(); }
+}
+
+export class AgentOSWorkDetailPart extends Disposable {
+	private title: HTMLElement | undefined;
+	create(parent: HTMLElement): void {
+		const detail = DOM.append(parent, $('aside.agent-os-work-detail'));
+		DOM.append(detail, $('div.agent-os-detail-title', undefined, localize('currentWork', "当前工作")));
+		this.title = DOM.append(detail, $('div.agent-os-empty-title', undefined, localize('noTask', "尚未开始任务")));
+		DOM.append(detail, $('p', undefined, localize('noTaskHelp', "发送目标后，这里会显示计划、执行进度、产物和需要你决定的事项。")));
+	}
+	setPlanning(): void { if (this.title) { this.title.textContent = localize('planning', "正在形成执行计划"); } }
+}
+
+export class AgentOSWorkbenchParts extends Disposable {
+	private readonly taskList = this._register(new AgentOSTaskListPart());
+	private readonly master = this._register(new AgentOSMasterPart());
+	private readonly detail = this._register(new AgentOSWorkDetailPart());
+	create(parent: HTMLElement): void {
+		const root = DOM.append(parent, $('.agent-os-window'));
+		this.taskList.create(root, () => this.master.focus());
+		this.master.create(root, goal => {
+			const feed = root.querySelector<HTMLElement>('.agent-os-run-feed');
+			if (feed) { DOM.clearNode(feed); DOM.append(feed, $('div.agent-os-run-card', undefined, goal)); DOM.append(feed, $('div.agent-os-run-state', undefined, localize('queued', "已创建任务 · 正在准备执行"))); }
+			this.detail.setPlanning();
+		});
+		this.detail.create(root);
+	}
+}
