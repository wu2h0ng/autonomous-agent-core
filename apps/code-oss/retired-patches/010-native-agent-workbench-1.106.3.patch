+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Agent OS contributors. All rights reserved.
+ *  Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { INativeWindowConfiguration } from '../../../platform/window/common/window.js';
+import { ServiceCollection } from '../../../platform/instantiation/common/serviceCollection.js';
+import { ILogService } from '../../../platform/log/common/log.js';
+import { Workbench, IWorkbenchOptions } from '../../browser/workbench.js';
+import { DesktopMain } from '../../electron-browser/desktop.main.js';
+
+/** Starts the real Code-OSS service graph for the first-class Agent OS window. */
+export class AgentOSWorkbench extends Workbench { }
+
+export class AgentOSWindowMain extends DesktopMain {
+	protected override createWorkbench(parent: HTMLElement, options: IWorkbenchOptions, serviceCollection: ServiceCollection, logService: ILogService): Workbench {
+		return new AgentOSWorkbench(parent, { ...options, extraClasses: [...(options.extraClasses ?? []), 'agent-os-native-workbench'] }, serviceCollection, logService);
+	}
+}
+
+export function main(configuration: INativeWindowConfiguration): Promise<void> {
+	return new AgentOSWindowMain(configuration).open();
+}
