+import { IViewsService } from '../../../services/views/common/viewsService.js';
+import { CHAT_SIDEBAR_PANEL_ID } from '../../chat/browser/chatViewPane.js';
+import { VIEWLET_ID as SCM_VIEWLET_ID } from '../../scm/common/scm.js';
+import { TERMINAL_VIEW_ID } from '../../terminal/common/terminal.js';
+
+const IDE_ONLY = ContextKeyExpr.notEquals('agentOS.isAgentWindow', true);
+
+abstract class AgentCodingLayoutAction extends Action2 {
+	protected showIDE(layoutService: IWorkbenchLayoutService): void {
+		layoutService.setPartHidden(false, Parts.ACTIVITYBAR_PART);
+		layoutService.setPartHidden(false, Parts.SIDEBAR_PART);
+		layoutService.setPartHidden(false, Parts.EDITOR_PART);
+	}
+}
+
+registerAction2(class OpenAgentCodingAction extends AgentCodingLayoutAction {
+	constructor() {
+		super({
+			id: 'agentOS.coding.openAgent',
+			title: localize2('agentOS.coding.openAgent', "Open Coding Agent"),
+			category: Categories.View,
+			icon: Codicon.chatSparkle,
+			precondition: IDE_ONLY,
+			f1: true,
+			keybinding: {
+				primary: KeyMod.CtrlCmd | KeyCode.KeyL,
+				weight: KeybindingWeight.WorkbenchContrib
+			}
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const layoutService = accessor.get(IWorkbenchLayoutService);
+		this.showIDE(layoutService);
+		layoutService.setPartHidden(false, Parts.AUXILIARYBAR_PART);
+		await accessor.get(IViewsService).openViewContainer(CHAT_SIDEBAR_PANEL_ID, true);
+	}
+});
+
+registerAction2(class OpenAgentReviewAction extends AgentCodingLayoutAction {
+	constructor() {
+		super({
+			id: 'agentOS.coding.openReview',
+			title: localize2('agentOS.coding.openReview', "Open Agent Review Layout"),
+			category: Categories.View,
+			icon: Codicon.diff,
+			precondition: IDE_ONLY,
+			f1: true
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const layoutService = accessor.get(IWorkbenchLayoutService);
+		this.showIDE(layoutService);
+		layoutService.setPartHidden(true, Parts.PANEL_PART);
+		layoutService.setPartHidden(false, Parts.AUXILIARYBAR_PART);
+		const viewsService = accessor.get(IViewsService);
+		await viewsService.openViewContainer(SCM_VIEWLET_ID, false);
+		await viewsService.openViewContainer(CHAT_SIDEBAR_PANEL_ID, true);
+	}
+});
+
+registerAction2(class OpenAgentRunAction extends AgentCodingLayoutAction {
+	constructor() {
+		super({
+			id: 'agentOS.coding.openRun',
+			title: localize2('agentOS.coding.openRun', "Open Agent Run Layout"),
+			category: Categories.View,
+			icon: Codicon.terminal,
+			precondition: IDE_ONLY,
+			f1: true
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const layoutService = accessor.get(IWorkbenchLayoutService);
+		this.showIDE(layoutService);
+		layoutService.setPartHidden(false, Parts.AUXILIARYBAR_PART);
+		layoutService.setPartHidden(false, Parts.PANEL_PART);
+		const viewsService = accessor.get(IViewsService);
+		await viewsService.openViewContainer(CHAT_SIDEBAR_PANEL_ID, false);
+		await viewsService.openView(TERMINAL_VIEW_ID, true);
+	}
+});
