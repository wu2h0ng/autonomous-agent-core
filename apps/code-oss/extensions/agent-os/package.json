{
  "name": "agent-os",
  "displayName": "Agent OS",
  "description": "Agent OS Surface and governed Runtime integration",
  "version": "0.1.0",
  "publisher": "agent-os",
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "vscode": "^1.106.0" },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "contributes": {
    "commands": [
      { "command": "agentOS.retryRuntime", "title": "Retry Runtime Connection", "category": "Agent OS" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "agentOS.retryRuntime" }
      ]
    },
    "configuration": {
      "title": "Agent OS",
      "properties": {
        "agentOS.runtimeDescriptor": {
          "type": "string",
          "default": "~/.agent-os/runtime.json",
          "description": "Private local Agent OS Runtime descriptor path."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.106.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
