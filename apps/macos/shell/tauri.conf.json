{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent OS",
  "version": "0.1.0",
  "identifier": "com.agent-os.runtime",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../renderer",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ./renderer",
    "frontendDist": "../renderer/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent OS",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}